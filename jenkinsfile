podTemplate {
    node('pod-templ-jenkins-slave-common') {

		env.IMAGE_NAME = "${IOT_IMAGES_REGISTRY}/${DEVOPS}/${JOB_NAME}"
		env.IMAGE_NAME_SHORT = "${DEVOPS}/${JOB_NAME}"
        env.SVN_Add = "${SVN_ADDRESS}/FS-IOT/trunk/code/gowork/src/video-recognition"
        env.SVN_Base = "${SVN_ADDRESS}/FS-IOT/trunk/code/gowork/src/base"

	    stage('Run shell') {
		    checkout([$class: 'SubversionSCM', filterChangelog: false, locations: [
            [cancelProcessOnExternalsFail: true, credentialsId: 'svn-build', depthOption: 'infinity', ignoreExternalsOption: true, local: './base', remote: "${SVN_Base}"],
            [cancelProcessOnExternalsFail: true, credentialsId: 'svn-build', depthOption: 'infinity', ignoreExternalsOption: true, local: './video-recognition', remote: "${SVN_Add}"]
            ], quietOperation: true, workspaceUpdater: [$class: 'UpdateUpdater']])

		    container('image-builder') {
				sh'''
				    /kaniko/executor --context=${BUILD_WORKSPACE} --dockerfile=./video-recognition/Dockerfile --destination=${IMAGE_NAME}:${IMAGE_VERSION} --cache=false --cleanup
			    '''
		    }

		    buildName "${IMAGE_NAME_SHORT}:${IMAGE_VERSION}"
		    buildDescription "${IMAGE_NAME}:${IMAGE_VERSION}"
		}
	}
}
